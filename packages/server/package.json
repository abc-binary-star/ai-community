{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI Community 社区底座后端（Hono + Prisma）",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@prisma/client": "^5.18.0",
    "bcryptjs": "^2.4.3",
    "hono": "^4.6.0",
    "jsonwebtoken": "^9.0.2",
    "shared": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "prisma": "^5.18.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
