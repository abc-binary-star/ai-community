# ============================================
# AI Community 生产环境配置
# 复制此文件为 .env.production 并填入真实值
# ============================================

# ---- Nginx 端口 ----
NGINX_PORT=80

# ---- JWT 密钥（必须更换！至少 32 位随机字符串）----
# 生成方式：openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ---- CORS 允许的域名（逗号分隔多个）----
# 重要：由于后端启用了 credentials: true，CORS_ORIGIN 不能使用 *，必须填写具体域名
# 如果你的域名是 example.com，填写：CORS_ORIGIN=https://example.com
# 如果用服务器 IP 直接访问，填写：CORS_ORIGIN=http://你的服务器IP
# 多个域名用逗号分隔：CORS_ORIGIN=https://example.com,https://www.example.com
CORS_ORIGIN=https://example.com

# ---- DeepSeek AI 配置（AI 标签推荐 / 讨论摘要）----
# 不配置时 AI 功能不可用，但不影响社区基础功能
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- 数据库（docker-compose 内部已配置，通常不需修改）----
# 如需外部数据库，注释掉 docker-compose 里的 postgres 服务，修改下方 DATABASE_URL
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=disable
