# ============================================
# AI Community 生产环境配置
# 复制此文件为 .env.production 并填入真实值
# ============================================

# ---- Nginx 端口 ----
NGINX_PORT=80

# ---- JWT 密钥（必须更换！至少 32 位随机字符串）----
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ---- CORS 允许的域名（逗号分隔多个）----
# 如果你的域名是 example.com，填写：CORS_ORIGIN=https://example.com
# 如果用服务器 IP 直接访问，填写：CORS_ORIGIN=http://你的服务器IP
# 多个域名用逗号分隔：CORS_ORIGIN=https://example.com,https://www.example.com
CORS_ORIGIN=*

# ---- 数据库（docker-compose 内部已配置，通常不需修改）----
# 如需外部数据库，注释掉 docker-compose 里的 postgres 服务，修改下方 DATABASE_URL
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?schema=public
