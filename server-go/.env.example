# 数据库连接
DATABASE_URL=postgresql://aicom:aicom_dev@localhost:5432/aicom?sslmode=disable

# 服务端口
PORT=3001

# JWT 密钥（生产环境必须配置，至少 32 位随机字符串）
JWT_SECRET=dev-secret-change-me

# CORS 允许的域名（逗号分隔）
CORS_ORIGIN=http://localhost:3000

# 环境变量
NODE_ENV=development

# DeepSeek AI 标签推荐
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenAI Whisper 语音转文字（留空则语音功能不可用）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
