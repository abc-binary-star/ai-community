# 数据库连接
DATABASE_URL=postgresql://aicom:aicom_dev@localhost:5432/aicom?sslmode=disable

# 服务端口
PORT=3001

# JWT 密钥（生产环境必须配置，至少 32 位随机字符串）
JWT_SECRET=dev-secret-change-me

# CORS 允许的域名（逗号分隔）
CORS_ORIGIN=http://localhost:3000

# 环境变量
NODE_ENV=development

# DeepSeek AI 标签推荐
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 火山引擎语音识别（豆包流式ASR，留空则语音功能不可用）
VOLC_ASR_API_KEY=
VOLC_ASR_RESOURCE_ID=volc.bigasr.sauc.duration

# AI 限流配置（可选，留空使用默认值）
AI_CONCURRENT_LIMIT=5
AI_DAILY_TOKEN_LIMIT=2000000
