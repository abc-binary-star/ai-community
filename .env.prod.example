# ===== 必填 1：镜像仓库（GitHub Actions 构建产物所在）=====
# 登录阿里云控制台 → 容器镜像服务 → 复制官方给的登录命令中的 registry 地址
REGISTRY_URL=crpi-cqoipccqhztgqcv8.cn-beijing.personal.cr.aliyuncs.com
# 登录阿里云控制台 → 容器镜像服务 → 你的"命名空间"名称
REGISTRY_NAMESPACE=替换为你的命名空间
# 镜像服务控制台 → 访问凭证 → 固定密码
REGISTRY_USERNAME=替换为你的阿里云账号
REGISTRY_PASSWORD=替换为固定密码

# ===== 必填 2：应用安全 =====
# 生成随机密钥：ssh 登录服务器后执行  openssl rand -hex 32
JWT_SECRET=替换为随机32位以上字符串
# 你的服务器公网 IP（用 IP 访问时填这个）
CORS_ORIGIN=http://替换为你的服务器公网IP

# ===== 可选：DeepSeek AI（不填则 AI 功能不可用）=====
DEEPSEEK_API_KEY=sk-替换为你的DeepSeek密钥

# ===== 可选：火山引擎语音识别（不填则语音功能不可用）=====
VOLC_ASR_API_KEY=替换为火山引擎API Key
VOLC_ASR_RESOURCE_ID=volc.bigasr.sauc.duration

# ===== 可选：AI 限流配置（不填使用默认值）=====
AI_CONCURRENT_LIMIT=5
AI_DAILY_TOKEN_LIMIT=2000000
# 免费 / 订阅用户每日 token 预算
AI_FREE_DAILY_TOKEN_LIMIT=100000
AI_PRO_DAILY_TOKEN_LIMIT=500000
# 免费 / 订阅用户全局每日 token 分池
AI_FREE_GLOBAL_TOKEN_POOL=700000
AI_PRO_GLOBAL_TOKEN_POOL=1300000
# 免费 / 订阅用户润色单次字数上限
AI_FREE_REWRITE_MAX_CHARS=8000
AI_PRO_REWRITE_MAX_CHARS=40000
# 免费用户语音转文字单次时长上限（秒）
AI_FREE_TRANSCRIBE_MAX_SECONDS=180

# ===== 必填 3：阿里云 OSS 对象存储（图片/头像存储，不配置则图片无法正常显示）=====
# 1. 阿里云控制台 → OSS → 创建 Bucket（如 ai-community-take），权限设置为「公共读」
# 2. RAM 访问控制 → 创建子用户 AccessKey，仅授权该 Bucket 读写
# 3. Endpoint 不带协议前缀；若你的 S3_ENDPOINT 带 https:// 前缀，需同时配置 S3_PUBLIC_BASE_URL
S3_ENDPOINT=oss-cn-beijing.aliyuncs.com
S3_REGION=oss-cn-beijing
S3_BUCKET=替换为你的Bucket名称
S3_ACCESS_KEY_ID=替换为AccessKey ID
S3_SECRET_ACCESS_KEY=替换为AccessKey Secret
# 公网访问地址（不填则默认 https://{bucket}.{endpoint}，需 Bucket 公共读）
S3_PUBLIC_BASE_URL=https://替换为你的Bucket名称.oss-cn-beijing.aliyuncs.com
